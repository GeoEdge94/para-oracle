# Base Sepolia deployment
PRIVATE_KEY=0x...                                 # Deployer wallet (EOA)
BASE_SEPOLIA_RPC=https://sepolia.base.org         # or Alchemy/Infura
BASESCAN_API_KEY=...                              # https://basescan.org/myapikey

# Post-deploy roles
ADMIN_ADDRESS=0x...                               # optional (defaults to deployer)
RESOLVER_ADDRESS=0x...                            # optional (defaults to deployer)

# Gas reporting
REPORT_GAS=false
