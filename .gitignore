contracts/cache/
contracts/out/
contracts/lib/
veralith-pipeline/contracts/cache/
veralith-pipeline/contracts/artifacts/
veralith-pipeline/contracts/typechain-types/

# ─── Docker ───────────────────────────────────────────────────────────────
.docker/

