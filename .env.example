# Copier en `.env` a la racine : cp .env.example .env
# Le fichier .env est lu par :
#   - docker-compose.yml (passage aux containers)
#   - backend/app/core/config.py (via pydantic-settings)
#   - Foundry : `source .env && forge script ...` (Foundry ne lit PAS .env
#     automatiquement depuis la racine du monorepo)

# ─── Database ──────────────────────────────────────────────────────────────
POSTGRES_DB=paraoracle
POSTGRES_USER=paraoracle
POSTGRES_PASSWORD=paraoracle_dev

# ─── Copernicus Data Space Ecosystem (STAC Sentinel-2, gratuit) ────────────
# Register at https://dataspace.copernicus.eu/
COPERNICUS_BASE_URL=https://catalogue.dataspace.copernicus.eu
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
USE_MOCK_SENTINEL=true

# ─── Copernicus Climate Data Store (ERA5-Land meteo, gratuit) ──────────────
# Register at https://cds.climate.copernicus.eu/
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=
USE_MOCK_CDS=true

# ─── Sentinel Hub (commercial, WMS/Process API) ────────────────────────────
# Register at https://services.sentinel-hub.com — client ID has prefix "sh-"
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_TOKEN_URL=https://services.sentinel-hub.com/oauth/token
SENTINEL_HUB_WMS_URL=https://services.sentinel-hub.com/ogc/wms
SENTINEL_HUB_INSTANCE_ID=

# ─── Web3 : publishing global ──────────────────────────────────────────────
# true = chaine complete pin IPFS + notarize TLS + submit on-chain
# false = pipeline seul, pas de side-effects Web3 (dev local ultra-rapide)
USE_WEB3_PUBLISHING=true

# ─── Web3 : IPFS (Pinata) ──────────────────────────────────────────────────
# Mock = CID deterministe SHA-256 + fichier dans ./data/ipfs-mock/ (defaut)
# Real = Pinata pinning via PINATA_JWT (gratuit jusqu'a 1 GB)
#   https://app.pinata.cloud → API Keys → create new (with pinFileToIPFS scope)
USE_MOCK_IPFS=true
PINATA_JWT=
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
SCHEMA_V1_CID=

# ─── Web3 : TLSNotary (PSE) ────────────────────────────────────────────────
# Mock = enveloppe stub shape-compatible PSE v0.x (defaut)
# Real = notaire PSE (M4bis, _real_proof pas encore implemente)
USE_MOCK_TLSNOTARY=true
TLSNOTARY_NOTARY_URL=

# ─── Web3 : Smart contract ParaOracle (Polygon Amoy testnet) ───────────────
# Mock = tx_hash deterministe, pas d'appel RPC (defaut)
# Real = web3.py submit contre PARA_ORACLE_ADDRESS deploye
USE_MOCK_CHAIN=true
CHAIN_RPC_URL=https://rpc-amoy.polygon.technology
CHAIN_ID=80002

# ORACLE_PRIVATE_KEY : clef privee du backend qui signe submitResolution().
# IMPORTANT : differente de la clef du challenger bot (CHALLENGER_PRIVATE_KEY
# en M4bis). Wallet doit etre fonde en MATIC (gas) + USDC (bond).
# Faucet Amoy MATIC : https://faucet.polygon.technology/
ORACLE_PRIVATE_KEY=

# Adresse du contrat ParaOracle.sol apres deploiement (section "Deploiement
# real" du docs/web3/README.md). Laisser vide tant que pas deploye.
PARA_ORACLE_ADDRESS=

# Adresse USDC sur Amoy. Si vide, Deploy.s.sol creera un MockERC20 "tUSDC".
# USDC officiel Amoy (6 decimales) : 0x41E94Eb019C0762f9Bfcf9Fb1E58725BfB0e7582
USDC_ADDRESS=

# Bond requis pour submitResolution + dispute (6 decimales USDC).
# 500 USDC = 500_000_000 dans Deploy.s.sol (Foundry), 500.0 cote Python.
BOND_AMOUNT_USDC=500.0

# Fenetre de dispute en secondes. 48h par defaut.
DISPUTE_WINDOW_SECONDS=172800

# ─── Web3 : Foundry deploy only ────────────────────────────────────────────
# PRIVATE_KEY : lu par contracts/script/Deploy.s.sol via vm.envUint
# En pratique, duplique ORACLE_PRIVATE_KEY (mais sans prefixe 0x pour Foundry).
# Garde les 2 pour que `source .env && forge script` marche.
PRIVATE_KEY=

# ─── Backend ───────────────────────────────────────────────────────────────
JWT_SECRET=para_oracle_dev_secret_change_me_in_prod
CORS_ORIGINS=http://localhost:3000

# ─── Frontend ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_QGIS_WMS_URL=http://localhost:8080/wms
